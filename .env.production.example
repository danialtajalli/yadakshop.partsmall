APP_NAME=Partsmall
APP_ENV=production

# Clarity loads only in production; this integration has no consent popup.
CLARITY_ENABLED=true
CLARITY_PROJECT_ID=z02pt3ef4k
# Preserve the APP_KEY from the live installation.
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

WEB_PORT=8000
DOCKER_SUBNET=172.30.50.0/24
PRODUCTION_VOLUME_PREFIX=partsmall-prod
# Before importing, set UPLOAD_SOURCE to the existing server's upload directory.
# UPLOAD_SOURCE=/absolute/path/to/current/uploads
MYSQL_ADMIN_PORT=3307
# Verify the source database engine/version and a trial restore before cutover.
MYSQL_VERSION=8.4
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=partsmall
DB_USERNAME=partsmall
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

QUEUE_CONNECTION=redis
DB_QUEUE_RETRY_AFTER=180
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis-queue
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_DB=0
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=queue
REDIS_QUEUE_HOST=redis-queue
REDIS_QUEUE_DB=0
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE_RETRY_AFTER=180
REDIS_QUEUE_BLOCK_FOR=5
REDIS_VERSION=7.4.11-alpine
REDIS_CACHE_MAXMEMORY=256mb
REDIS_QUEUE_MAXMEMORY=256mb
# One-day recovery window; maintain verified off-server backups/binlog archives.
# Retention limits age, not total bytes. Reassess after the Redis/cache rollout.
MYSQL_BINLOG_EXPIRE_LOGS_SECONDS=86400
MYSQL_MAX_BINLOG_SIZE=67108864
MYSQL_BINLOG_TRANSACTION_COMPRESSION=ON
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILES=5
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120
SCOUT_DRIVER=collection
FILESYSTEM_DISK=local
LOG_CHANNEL=stderr
LOG_LEVEL=info
MAIL_MAILER=log
MAIL_FROM_ADDRESS=info@partsmall.ir
MAIL_FROM_NAME=Partsmall
REQUEST_LOG_INCOMING_ENABLED=true

# Carry over the live mail, contact pipeline, and captcha settings before launch.
CONTACT_PIPELINE=database_only
DIDAR_API_KEY=
DIDAR_DEAL_OWNER_USERNAME=
DIDAR_DEAL_FIELD_KEY=Field_8783_0_1
DIDAR_API_BASE=https://app.didar.me/api/
DIDAR_VERIFY_SSL=true
DIDAR_CURL_CAFILE=
ARCAPTCHA_SITE_KEY=
ARCAPTCHA_SECRET_KEY=
